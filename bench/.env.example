# Copy to bench/.env (git-ignored). Every model is called through Vercel AI Gateway.
AI_GATEWAY_API_KEY=

# Optional. jev's AI Gateway id (default: typesafe-ai/jev).
# BENCH_JEV_MODEL=typesafe-ai/jev

# Optional. Comma-separated AI Gateway ids, one structured-output baseline each
# (default: openai/gpt-5.4-mini). Add each id's price to bench/prices.json.
# BENCH_BASELINE_MODELS=openai/gpt-5.4-mini

# Optional. Requests in flight per system (default: 8).
# BENCH_CONCURRENCY=8

# Optional. The benchmark's models (pnpm bench); defaults in bench/src/config.ts.
# The judge must come from a provider none of the others use.
# BENCH_TEXT_LOW_MODEL=anthropic/claude-haiku-4.5
# BENCH_TEXT_HIGH_MODEL=anthropic/claude-sonnet-5.5
# BENCH_FRONTIER_MODEL=anthropic/claude-opus-5.5
# BENCH_CHEAP_MODEL=anthropic/claude-haiku-4.5
# BENCH_JUDGE_MODEL=openai/gpt-5.5

# Never set this without the owner's decision: the test split is run once, after tuning.
# BENCH_ALLOW_TEST=1
